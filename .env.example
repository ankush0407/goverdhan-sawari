# On a host (Railway sets PORT itself). DB_PATH must point into an attached volume or the data is lost on every redeploy.
PORT=3000
DB_PATH=/data/data.sqlite
# Password for the admin dashboard and API. On a public host use 24+ random characters, e.g. `openssl rand -hex 16`.
ADMIN_TOKEN=change-me
# Your own number as on the chat app, digits with country code. Only this number can use the Approve/Reject buttons.
ADMIN_PHONE=91XXXXXXXXXX
# Public https address of this server. The admin's /admin command offers an "Open dashboard" button that opens it inside Telegram.
# On Railway this is filled in automatically from the generated domain; set it yourself anywhere else.
PUBLIC_URL=
# Set to true ONLY while testing: lets the admin dashboard erase all rides, drivers and riders (a backup copy is saved first).
# Leave it unset once real drivers and riders use the app.
ALLOW_DATA_RESET=

# Meta WhatsApp Cloud API (leave unset to run Telegram or the dev simulator)
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_VERIFY_TOKEN=pick-any-string
WA_APP_SECRET=

# Telegram stand-in while WhatsApp approval is pending (used only when WA_* is unset). Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Product knobs (quote values with spaces: this file is also loaded with `source`)
BRAND="Govardhan Sawari"
PARIKRAMA_FARE_PER_SEAT=50
QUOTE_WINDOW_SEC=180
CHOOSE_WINDOW_SEC=600
NEARBY_KM=5
WIDE_KM=15
FEEDBACK_DELAY_SEC=300
